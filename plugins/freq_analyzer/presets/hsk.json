{
  "name": "Hsk语料预设",
  "description": "保留中文字符，去除英文、标点、特殊符号",
  "rule": {
    "removeEnglish": true,
    "removeDigits": false,
    "removePunct": true,
    "removeWhitespace": true,
    "removeSpecialSymbols": true,
    "customRemoveList": [
      "[",
      "]",
      "{",
      "}",
      "【",
      "】"
    ],
    "customRegexList": [],
    "replaceMap": {},
    "lowercase": false
  }
}